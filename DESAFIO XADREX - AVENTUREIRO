#include <stdio.h>

/*
  xadrez.c
  Simulação de movimentos das peças de xadrez:
  - Torre (for)
  - Bispo (while)
  - Rainha (do-while)
  - Cavalo (for + while aninhados)
  Desenvolvedor: Paulo Cesar, aluno Estacio
*/

int main(void) {
    /* Identificação inicial */
    printf("Desenvolvedor: Paulo Cesar, aluno Estacio\n\n");

    // ----------------------------------------------------
    // Movimento da Torre (utilizando for)
    // ----------------------------------------------------
    int movimentosTorre = 5; // número de casas que a Torre irá andar
    printf("Movimento da Torre:\n");
    for (int i = 1; i <= movimentosTorre; i++) {
        printf("Direita\n");
    }

    // ----------------------------------------------------
    // Movimento do Bispo (utilizando while)
    // ----------------------------------------------------
    int movimentosBispo = 5; // número de casas do Bispo
    int contadorBispo = 0;   // contador para o while
    printf("\nMovimento do Bispo:\n");
    while (contadorBispo < movimentosBispo) {
        printf("Cima, Direita\n");
        contadorBispo++;
    }

    // ----------------------------------------------------
    // Movimento da Rainha (utilizando do-while)
    // ----------------------------------------------------
    int movimentosRainha = 8; // número de casas da Rainha
    int contadorRainha = 0;   // contador para o do-while
    printf("\nMovimento da Rainha:\n");
    do {
        printf("Esquerda\n");
        contadorRainha++;
    } while (contadorRainha < movimentosRainha);

    // ----------------------------------------------------
    // Movimento do Cavalo (loops aninhados)
    // ----------------------------------------------------
    /*
      O Cavalo se move em “L”: duas casas em uma direção e uma casa perpendicular.
      Neste exemplo: duas casas para BAIXO e uma para a ESQUERDA.

      Implementação:
      - Um loop for controla as 2 casas para baixo.
      - Dentro dele, um loop while imprime o movimento "Baixo".
      - Depois do for terminar, usamos outro loop (while) para 1 casa para a esquerda.
    */
    int movimentosBaixo = 2;    // casas para baixo
    int movimentosEsquerda = 1; // casas para esquerda
    int contadorExterno, contadorInterno;

    printf("\nMovimento do Cavalo:\n");

    // Loop externo (for) → controla as 2 casas para baixo
    for (contadorExterno = 0; contadorExterno < movimentosBaixo; contadorExterno++) {
        // Loop interno (while) → executa uma vez para cada passo "Baixo"
        contadorInterno = 0;
        while (contadorInterno < 1) {
            printf("Baixo\n");
            contadorInterno++;
        }
    }

    // Movimento final do cavalo → 1 casa para esquerda
    int contadorEsquerda = 0;
    while (contadorEsquerda < movimentosEsquerda) {
        printf("Esquerda\n");
        contadorEsquerda++;
    }

    /* Identificação final */
    printf("\nDesenvolvedor: Paulo Cesar, aluno Estacio\n");

    return 0;
}
